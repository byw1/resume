# ---------------------------------------------------------------------------
# Resume OS
#
# Exactly one variable is required, and your host fills it in for you.
# On first boot the app creates your owner account and prints the password
# to the server log — you don't invent or configure any credentials.
# ---------------------------------------------------------------------------

# On Railway, set this to a reference to your Postgres service:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Locally, point it at any Postgres you have.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_os"

# --- everything below is optional -------------------------------------------

# Use this address for the auto-created owner account.
# Defaults to owner@localhost, which you can change from Settings.
# ADMIN_EMAIL="you@example.com"

# Use this as the owner's first password instead of a generated one.
# Leave it unset and a strong passphrase is generated and logged for you.
# APP_PASSWORD=""

# Set to 1 and restart to generate a fresh owner password and print it again.
# Remove it afterwards, or it resets on every boot.
# RESET_OWNER_PASSWORD=""
