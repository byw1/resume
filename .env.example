# ---------------------------------------------------------------------------
# Resume OS — there are only two variables, and Railway fills in the first one.
# ---------------------------------------------------------------------------

# Set this in Railway to a reference to your Postgres service:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Locally, point it at any Postgres you have.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_os"

# The password you'll type to get into the app. Pick anything.
# Leave it unset and the app is open to anyone with the link.
APP_PASSWORD="change-me"
