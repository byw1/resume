# ---------------------------------------------------------------------------
# Resume OS — there are only two variables, and Railway fills in the first one.
# ---------------------------------------------------------------------------

# Set this in Railway to a reference to your Postgres service:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
# Locally, point it at any Postgres you have.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_os"

# The setup key. On first run you enter this to claim the instance as owner —
# it stops anyone else who finds your URL claiming it first. After setup you
# sign in with the email and password you chose, not with this.
# Everything else (email, invites, accounts) is configured inside the app.
APP_PASSWORD="change-me"
